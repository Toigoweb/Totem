# Variabili dell'installazione per docker-compose.yml.
# Con docker compose: copiare come /opt/totem/.env (accanto al compose).
# Con Portainer: inserirle in "Environment variables" dello stack (o caricare questo file
# con "Load variables from .env file").
# Righe commentate = valore di default.

# Porta sul server Docker verso cui punta Nginx Proxy Manager. Anche indirizzo:porta,
# per esporla su una sola scheda di rete (es. 192.168.10.5:8090).
TOTEM_PORT=8080

# Cartelle sul server (percorsi assoluti), proprietario 65532:65532.
#TOTEM_DATA_DIR=/opt/totem/data
#TOTEM_SECRETS_DIR=/opt/totem/secrets

# Versione dell'immagine. Lasciare commentata per l'aggiornamento automatico
# (Portainer). 1.0.0 = versione bloccata; 1 = ultima 1.x con "docker compose pull".
#TOTEM_TAG=

#TZ=Europe/Rome
